# SiteGround/Apache configuration for the generated Nuxt static site.
# Replace any legacy WordPress .htaccess in public_html with this file on deploy.
Options -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep all production traffic encrypted.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Do not bootstrap legacy WordPress when the static site is present.
  RewriteRule ^index\.php$ - [F,L]

  # Hashed build assets and public files must never fall through to PHP rewrites.
  RewriteRule ^(_nuxt|_fonts|images|docs|favicon|apple-touch-icon|web-app-manifest|site\.webmanifest|robots\.txt|sitemap\.xml) - [L]

  # Serve Nuxt's route/index.html files without redirecting /route to /route/.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # @sync-security-headers-start
  # Security headers (synced from security-headers.mjs)
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# @sync-security-headers-end

  # HTML and metadata should be revalidated after every deployment.
  <FilesMatch "\.(?:html?|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Nuxt emits content-hashed assets, so they can be cached long-term.
  <FilesMatch "\.(?:avif|css|gif|ico|jpe?g|js|mjs|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml text/css text/html text/javascript text/plain text/xml
</IfModule>
