{
  "name": "khpc_company_website",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm sync:host-headers && nuxt generate && node scripts/write-sitemap.mjs",
    "generate": "pnpm sync:host-headers && nuxt generate && node scripts/write-sitemap.mjs",
    "generate:siteground": "node scripts/sync-siteground-htaccess.mjs && nuxt generate && node scripts/write-sitemap.mjs",
    "build:siteground": "pnpm generate:siteground && node scripts/package-siteground.mjs",
    "sync:host-headers": "node scripts/sync-vercel-security-headers.mjs && node scripts/sync-siteground-htaccess.mjs",
    "sync:vercel-headers": "node scripts/sync-vercel-security-headers.mjs",
    "sync:siteground-htaccess": "node scripts/sync-siteground-htaccess.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/ui": "^4.9.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.5"
  }
}
